/*
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# `remix/assets` preserves source extensions in browser module URLs. Netlify
# otherwise serves TypeScript source files as non-JavaScript MIME types. Module
# URLs carry the build id (`/assets/<build>/app/...`), and everything under
# /assets is a JavaScript module.
/assets/*
  Content-Type: application/javascript; charset=utf-8

# The Remix asset server exposes this stylesheet beside browser modules. Keep
# its real MIME type so browsers apply its global box-sizing reset.
/assets/:buildId/app/ui/public/reset.css
  Content-Type: text/css; charset=utf-8
