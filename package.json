{
  "name": "test-device-lockscreens",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "icons": "node scripts/generate-icons.mjs",
    "theme": "node --import remix/node-tsx scripts/generate-theme.ts",
    "build": "node scripts/generate-icons.mjs && NODE_ENV=production node --import remix/node-tsx scripts/build.tsx",
    "preview": "node scripts/preview.mjs",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app scripts server.ts hmr.ts",
    "format": "oxfmt app scripts server.ts hmr.ts",
    "format:check": "oxfmt --check app scripts server.ts hmr.ts"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "bowser": "^2.14.1",
    "remix": "^3.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "latest"
  }
}
